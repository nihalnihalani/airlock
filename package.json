{
  "name": "airlock",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test ./apps ./packages ./scripts",
    "dev:control": "bun run --cwd apps/control dev",
    "dev:supervisor": "bun run --cwd apps/supervisor dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:up": "scripts/dev-up.sh",
    "dev:down": "scripts/dev-down.sh",
    "smoke": "bun scripts/smoke.ts",
    "test:python": "python3 -m pytest runtime/python/tests runtime/outputs/tests -q",
    "test:browser": "node --test runtime/browser/test/*.test.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@vercel/functions": "3.9.9",
    "bun-types": "^1.4.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@airlock/contracts": "workspace:*",
    "zod": "^3.23.8"
  }
}
