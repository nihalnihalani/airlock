# Airlock environment reference. Copy to .env for local work (gitignored; scripts/dev-up.sh loads it
# after the generated data/dev.env, and variables exported in your shell win over both). In a
# deployment these come from the process environment (systemd unit / shell), one process per VM.
# Every variable below is read by the code; defaults are the code's defaults. Secrets never go in git.

# ============================================================================================
# Shared secrets (both processes)
# ============================================================================================
SUPERVISOR_TOKEN=                       # required by BOTH; bearer secret for the supervisor API. dev-up generates one into data/dev.env

# ============================================================================================
# Control plane (VM A) — apps/control
# ============================================================================================
PORT=3000                               # control: listen port
CONTROL_BIND=0.0.0.0                    # control: bind address (dev-up uses 127.0.0.1)
AIRLOCK_DATA_DIR=./data                 # control: PGlite + artifact blobs (dev-up: data/control). The supervisor reads the same name for its own dir.
AIRLOCK_PROFILES_DIR=                   # control + supervisor: default <repo>/profiles
AIRLOCK_RUNTIME_DIR=                    # control: default <repo>/runtime/python (adapter digest is read from here)
AIRLOCK_WEB_DIST=                       # control: built web UI to serve (dev-up: apps/web/dist); unset = API only
SUPERVISOR_URL=http://127.0.0.1:4300    # control: private address of VM B's supervisor (deployment: the VPC address)

# Model driver
AIRLOCK_MODEL_DRIVER=vultr              # control: "vultr" (live) or "scripted:<dir or JSON file>" (diagnostics/tests only)
VULTR_INFERENCE_API_KEY=                # control: Serverless Inference SUBSCRIPTION key (not the account API key); required for vultr
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
AIRLOCK_MODEL=                          # control: required for vultr; choose with `bun scripts/probe-model.ts`

# Sessions and roles
AIRLOCK_OPERATOR_PASSWORD=              # control: operator role (dev-up generates one into data/dev.env)
AIRLOCK_JUDGE_PASSWORD=                 # control: judge role (dev-up generates one into data/dev.env)
AIRLOCK_INSECURE_COOKIES=0              # control: "1" allows non-Secure cookies (dev-up sets 1 for http://127.0.0.1)
AIRLOCK_TRUST_PROXY=0                   # control: "1" (same-host proxy) or proxy IPs; honours X-Forwarded-For only from those peers
AIRLOCK_SESSION_TTL_MS=43200000         # control: 12 h
AIRLOCK_EXPORT_GRANT_TTL_MS=86400000    # control: 24 h
AIRLOCK_HOSTILE_MIN_INTERVAL_MS=10000   # control: per-session rate limit on the hostile-input panel
AIRLOCK_PREVIEW_MIN_INTERVAL_MS=2000    # control: per-session rate limit on preview

# ============================================================================================
# Supervisor (VM B) — apps/supervisor. Holds the Docker socket; never runs on VM A.
# ============================================================================================
# PORT=4300                             # supervisor: listen port (same variable name as control; set per process)
SUPERVISOR_BIND=127.0.0.1               # supervisor: bind address. Deployment: the VPC address ONLY, never a public interface
AIRLOCK_RUNTIME=kata                    # supervisor: kata (target, VX1) | runsc (floor) | runc (local dev only, needs AIRLOCK_DEV_UNSAFE=1)
AIRLOCK_DEV_UNSAFE=0                    # supervisor: "1" permits runc and labels every record dev-unsafe. Never in a deployment
AIRLOCK_DOCKER_RUNTIME_NAME=            # supervisor: override the Docker runtime name if the daemon registers kata/runsc under another name
# AIRLOCK_DATA_DIR=data/supervisor      # supervisor: journal + sentinel dir (dev-up: data/supervisor)
AIRLOCK_JOURNAL_PATH=                   # supervisor: default <AIRLOCK_DATA_DIR>/supervisor-journal.sqlite
AIRLOCK_NAMESPACE=airlock               # supervisor: label namespace so two deployments on one host never adopt each other's containers
AIRLOCK_RETENTION_MS=1800000            # supervisor: how long terminal attempts stay before the janitor deletes them (30 min)
AIRLOCK_JANITOR_INTERVAL_MS=30000       # supervisor: janitor/reconcile interval
DOCKER_SOCKET=                          # supervisor: explicit Docker socket path; wins over DOCKER_HOST
DOCKER_HOST=                            # supervisor + scripts: unix:// socket (Colima: unix://$HOME/.colima/default/docker.sock)

# ============================================================================================
# Local scripts only — scripts/dev-up.sh, scripts/smoke.ts, scripts/probe-model.ts, apps/web/vite.config.ts
# ============================================================================================
SUPERVISOR_PORT=4300                    # dev-up: port for the local supervisor
CONTROL_PORT=3000                       # dev-up: port for the local control plane
AIRLOCK_DATA_DIR_CONTROL=               # dev-up: default data/control
AIRLOCK_DATA_DIR_SUPERVISOR=            # dev-up: default data/supervisor
AIRLOCK_CONTROL_URL=http://127.0.0.1:3000  # smoke + vite dev proxy: where the control plane is
AIRLOCK_PROBE_TIMEOUT_MS=90000          # probe-model: per-request timeout
