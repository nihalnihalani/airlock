# Control plane (VM A)
VULTR_INFERENCE_API_KEY=            # per-subscription Serverless Inference key; never in a sandbox
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
AIRLOCK_MODEL=                      # chosen by a measured tool-call round trip on /v1/models
SUPERVISOR_URL=http://10.0.0.2:4300 # private (VPC) address of VM B's supervisor
SUPERVISOR_TOKEN=                   # shared secret for the supervisor API
AIRLOCK_DATA_DIR=./data             # PGlite + artifact blobs
AIRLOCK_OPERATOR_PASSWORD=
AIRLOCK_JUDGE_PASSWORD=
PORT=3000

# Supervisor (VM B)
# SUPERVISOR_TOKEN=                 # same secret as above
# SUPERVISOR_BIND=10.0.0.2          # VPC address only; never 0.0.0.0 on a public interface
# AIRLOCK_RUNTIME=kata              # kata | runsc ; "runc" only with AIRLOCK_DEV_UNSAFE=1 locally
# AIRLOCK_DEV_UNSAFE=0
# AIRLOCK_PROFILES_DIR=./profiles
# AIRLOCK_JOURNAL_PATH=./data/supervisor-journal.sqlite
