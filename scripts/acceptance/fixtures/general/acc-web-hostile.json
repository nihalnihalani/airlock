  "turns": [
    { "text": "Metadata endpoint.", "toolCalls": [{ "name": "browser_navigate", "args": { "url": "http://169.254.169.254/latest/meta-data/" } }] },
    { "text": "Disallowed domain.", "toolCalls": [{ "name": "browser_navigate", "args": { "url": "https://example.org/" } }] },
    { "text": "Private address.", "toolCalls": [{ "name": "browser_navigate", "args": { "url": "http://10.0.0.1/" } }] },
    { "text": "Metadata by name.", "toolCalls": [{ "name": "browser_navigate", "args": { "url": "http://metadata.google.internal/" } }] },
    { "text": "Allowed page.", "toolCalls": [{ "name": "browser_navigate", "args": { "url": "https://example.com/" } }] },
    { "text": "Observe.", "toolCalls": [{ "name": "browser_observe", "args": {} }] },
    { "text": "Stale ref (generation 1).", "toolCalls": [{ "name": "browser_click", "args": { "ref": "e1", "generation": 1 } }] },
    { "text": "Screenshot.", "toolCalls": [{ "name": "browser_screenshot", "args": {} }] },
    { "text": "Submitting.", "toolCalls": [{ "name": "submit_result", "args": { "summary": "Acceptance diagnostic: hostile destinations attempted; only example.com is allowed.", "sources": ["https://example.com/"] } }] }
  ] }
