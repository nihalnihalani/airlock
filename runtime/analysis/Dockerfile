# Airlock offline data-analysis runtime: airlock-runtime-analysis:<tag>
#
# Build from the REPOSITORY ROOT (the context must contain runtime/analysis, runtime/outputs and
# runtime/python/probe.sh, which is copied verbatim so the probe semantics are identical):
#   runtime/analysis/build.sh            (docker build -f runtime/analysis/Dockerfile -t airlock-runtime-analysis:dev .)
#
# Base image pin: the SAME multi-arch index digest as runtime/python/Dockerfile (python:3.12-slim,
# Python 3.12.14, Debian 13.7), so amd64 (VM B) and arm64 (dev) both resolve to a fixed manifest:
#   index  sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f
FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f

# Build-time only network use: hash-locked binary wheels (every distribution of every pinned version
# is hashed in requirements.lock, generated by `uv pip compile --generate-hashes --only-binary :all:`).
# --require-hashes + --no-deps + --only-binary: nothing unpinned, nothing compiled, no setup.py runs.
COPY --chown=root:root runtime/analysis/requirements.lock /opt/airlock/requirements.lock
RUN pip install --no-cache-dir --disable-pip-version-check --require-hashes --no-deps --only-binary :all: \
        -r /opt/airlock/requirements.lock \
 && pip freeze --disable-pip-version-check > /opt/airlock/pip-freeze.txt \
 # Remove the installer completely: pip, its console scripts and ensurepip's bundled wheel. At
 # runtime `pip install x` is "command not found" and `python3 -m pip` is "No module named pip".
 && python3 -m pip uninstall -y --disable-pip-version-check pip \
 && rm -rf /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12 \
           /usr/local/lib/python3.12/ensurepip /usr/local/lib/python3.12/site-packages/pip* \
           /root/.cache

# Matplotlib: Agg only (headless, no GUI toolkit), font cache prebuilt into a read-only directory
# that the runner copies to MPLCONFIGDIR (/tmp is the only writable place besides /workspace).
ENV MPLBACKEND=Agg
RUN set -eu; \
    rc="$(python3 -c 'import matplotlib; print(matplotlib.matplotlib_fname())')"; \
    sed -i 's/^#\{0,2\}backend:.*/backend: Agg/' "$rc"; \
    grep -q '^backend: Agg' "$rc"; \
    mkdir -p /opt/airlock/mplcache; \
    MPLCONFIGDIR=/opt/airlock/mplcache python3 -c "import matplotlib.font_manager as fm; fm._load_fontmanager(try_read_cache=False); import matplotlib.pyplot"; \
    ls /opt/airlock/mplcache/fontlist-*.json

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_INDEX=1 \
    HOME=/tmp \
    MPLCONFIGDIR=/tmp/matplotlib

RUN groupadd --gid 1000 airlock \
 && useradd --uid 1000 --gid 1000 --home-dir /tmp --no-create-home --shell /bin/bash airlock \
 && mkdir -p /workspace \
 && chown 1000:1000 /workspace && chmod 0755 /workspace

# Fixed runtime scripts: the probe (verbatim from runtime/python), the output collector, the runner.
COPY --chown=root:root runtime/python/probe.sh /opt/airlock/probe.sh
COPY --chown=root:root runtime/outputs/collect_outputs.py /opt/airlock/collect_outputs.py
COPY --chown=root:root runtime/analysis/run.sh runtime/analysis/image_check.py /opt/airlock/

# Self-check (fails the build on any mismatch), strip setuid/setgid, lock modes.
RUN find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod a-s {} + \
 && find /opt/airlock -type d -exec chmod 0555 {} + \
 && find /opt/airlock -type f -exec chmod 0444 {} + \
 && chmod 0555 /opt/airlock/probe.sh /opt/airlock/collect_outputs.py /opt/airlock/run.sh /opt/airlock/image_check.py \
 && python3 -I /opt/airlock/image_check.py \
 && rm -rf /root/.cache /tmp/* /var/tmp/*

LABEL org.opencontainers.image.title="airlock-runtime-analysis" \
      airlock.base.index-digest="sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f" \
      airlock.role="analysis"

USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/sleep"]
CMD ["infinity"]
